<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Sample Forest Stand Boundary</name>
    <description>Sample ecological monitoring plot boundary for CanopyLens testing.</description>
    <Placemark>
      <name>Plot Alpha - Forest Boundary</name>
      <description>Study boundary covering temperate mixed woodland.</description>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>clampToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              -105.2705,40.0150,0
              -105.2680,40.0150,0
              -105.2680,40.0130,0
              -105.2705,40.0130,0
              -105.2705,40.0150,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>
  </Document>
</kml>
